        pushNatification("error", "Invalid Age", "Age must be between 18 and 90.");
        return;
    }
    if (salary.trim() === "") {
        pushNatification("error", "Error", "Salary is required.");
        return;
    }
    row.innerHTML = "\n        <td>".concat(nameE, "</td>\n        <td>").concat(position, "</td>\n        <td>").concat(officeText, "</td>\n        <td>").concat(age, "</td>\n        <td>$").concat(Number(salary).toLocaleString("en-US"), "</td>\n  ");
